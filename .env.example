# Salin ke .env untuk lokal. JANGAN commit file .env asli.
# Di Cloud Run, nilai runtime diisi lewat --set-env-vars / Secret Manager (lihat README).

# --- Server (runtime saja, TIDAK ditanam saat build) ---
# Project ID Firebase (Firestore + Admin SDK). Di Cloud Run, Admin SDK memakai
# service account bawaan runtime — TANPA file kunci.
FIREBASE_PROJECT_ID=
# ID database Firestore. Project ini memakai NAMED database "asinan-store"
# (bukan "(default)") — kosongkan hanya bila project-mu memakai default.
FIRESTORE_DATABASE_ID=asinan-store
# Kunci penanda tangan cookie sesi (acak, panjang). Di Cloud Run ambil dari Secret Manager.
SESSION_SECRET=
# Lokal saja: path file kunci service account ATAU pakai emulator.
GOOGLE_APPLICATION_CREDENTIALS=
# FIRESTORE_EMULATOR_HOST=localhost:8080
# URL publik aplikasi (untuk redirect setelah logout), mis. https://kas-asinan-xxxxx-uc.a.run.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Client Firebase (ditanam saat build lewat NEXT_PUBLIC_* / build args Docker) ---
# Dari Firebase Console → Project settings → Your apps (Web). Boleh kosong:
# aplikasi tetap build & jalan, tetapi tombol login nonaktif.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- 9Router & AI Chatbot / Telegram Bot ---
# Endpoint 9Router lokal atau remote
ROUTER_URL=http://localhost:20127/v1
# API Key 9Router
ROUTER_API_KEY=sk-5ec8186a854f88fa-695xy3-89481bfb
# Model 9Router (default: kimi)
ROUTER_MODEL=kimi
# Token Telegram Bot dari @BotFather (untuk runner script pnpm bot:telegram)
TELEGRAM_BOT_TOKEN=9101068944:AAExLeQJUzFs0ilhCCoSFLbGgCvnq1hpPZI
# Whitelist ID Telegram / username (opsional, pisahkan koma)
TELEGRAM_ALLOWED_USERS=

