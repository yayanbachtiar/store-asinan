# Salin ke .env / isi di environment runtime VPS. JANGAN commit file .env asli.
# Database PostgreSQL (runtime saja, tidak dipakai saat build image)
DATABASE_URL=postgres://asinan:GANTI_PASSWORD@db:5432/asinan
# Kunci penanda tangan cookie sesi (acak, panjang)
SESSION_SECRET=<redacted>
# Login Google (opsional — tombol login nonaktif anggun bila kosong)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publik aplikasi (untuk redirect OAuth), mis. https://asinan.contoh.id
NEXT_PUBLIC_APP_URL=http://localhost:3000
